#!/bin/bash
# {{ ansible_managed }}
#
# Refresh the Cloudflare edge IP list used by the "from_cf" ACL.
#
# The list itself is deliberately NOT templated by Ansible: this script owns
# its contents so a Cloudflare range change is picked up between deploys
# rather than being reverted by the next play.
set -euo pipefail

DEST='{{ haproxy_maps_path }}/cloudflare_ips.lst'
MIN_PREFIXES={{ cf_ips_min_prefixes }}
CFG='/etc/haproxy/haproxy.cfg'

tmp="$(mktemp)"
trap 'rm -f "$tmp"' EXIT

for url in https://www.cloudflare.com/ips-v4 https://www.cloudflare.com/ips-v6; do
  if ! curl -fsS --max-time 30 "$url" >> "$tmp"; then
    echo "refresh-cloudflare-ips: fetch failed for $url - keeping existing list" >&2
    exit 1
  fi
  printf '\n' >> "$tmp"
done

# Keep only well-formed CIDR prefixes; anything else means we got a captive
# portal, an error page or a truncated response.
grep -Eo '^[0-9a-fA-F:.]+/[0-9]{1,3}$' "$tmp" | sort -u > "$tmp.clean" || true
mv "$tmp.clean" "$tmp"

count="$(wc -l < "$tmp")"
if [ "$count" -lt "$MIN_PREFIXES" ]; then
  echo "refresh-cloudflare-ips: only $count prefixes (expected >= $MIN_PREFIXES) - keeping existing list" >&2
  exit 1
fi

if [ -f "$DEST" ] && cmp -s "$tmp" "$DEST"; then
  exit 0
fi

backup=''
if [ -f "$DEST" ]; then
  backup="$DEST.prev"
  cp -p "$DEST" "$backup"
fi

install -o root -g root -m 0644 "$tmp" "$DEST"

if ! haproxy -c -f "$CFG" > /dev/null 2>&1; then
  echo "refresh-cloudflare-ips: haproxy config check failed - rolling back" >&2
  if [ -n "$backup" ]; then
    mv "$backup" "$DEST"
  else
    rm -f "$DEST"
  fi
  exit 1
fi

systemctl reload haproxy
echo "refresh-cloudflare-ips: updated $DEST ($count prefixes)"
